# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key
PORT=5000

# MongoDB Atlas
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/snake_game?retryWrites=true&w=majority
MONGO_DB_NAME=snake_game

# If MONGO_URI is left as the placeholder above (or unreachable), the app
# automatically falls back to an in-memory mock database (mongomock) so you
# can run and demo the project without setting up Atlas first.
